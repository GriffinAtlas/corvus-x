{
  "name": "corvus-x",
  "version": "0.2.0",
  "description": "AI agent toolkit for X — investigate discourse, grow your presence, all from the terminal",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./cli": "./dist/bin/corvus.js"
  },
  "bin": {
    "corvus": "dist/bin/corvus.js",
    "corvus-mcp": "dist/bin/corvus-mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/corvus.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint bin/ src/ tests/",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "author": "Roger Griffin <roger@griffinatlas.us>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GriffinAtlas/corvus-x.git"
  },
  "keywords": [
    "cli",
    "twitter",
    "x",
    "grok",
    "ai",
    "intelligence",
    "terminal",
    "sentiment",
    "growth",
    "agent",
    "mcp",
    "algorithm",
    "profile",
    "tui"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@pppp606/ink-chart": "^0.2.4",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fullscreen-ink": "^0.1.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "openai": "^6.27.0",
    "ora": "^9.3.0",
    "react": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "eslint": "^10.0.3",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18"
  }
}
