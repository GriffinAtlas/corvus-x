# Required — Grok API key from https://console.x.ai
CORVUS_GROK_KEY=

# Optional — X API bearer token from https://developer.x.com
# Enriches results with real engagement data. All commands work without it.
CORVUS_X_BEARER_TOKEN=

# Optional — your X handle (without @). Used by growth commands.
CORVUS_X_HANDLE=
